<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>GrifLauncher</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #0b0e17; font-family: 'Segoe UI', sans-serif; color: #eef2ff; min-height: 100vh; display: flex; justify-content: center; align-items: center; }
        .container { max-width: 500px; width: 90%; margin: 40px auto; }
        .card { background: rgba(18,25,45,0.8); backdrop-filter: blur(10px); border-radius: 32px; padding: 40px; border: 1px solid rgba(59,130,246,0.3); }
        .logo { font-size: 32px; font-weight: 800; text-align: center; margin-bottom: 8px; background: linear-gradient(135deg, #fff, #3b82f6); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .subtitle { text-align: center; color: #8b9dc3; margin-bottom: 32px; font-size: 14px; }
        .input-group { margin-bottom: 20px; }
        .input-group input { width: 100%; padding: 14px; background: rgba(0,0,0,0.4); border: 1px solid #3b82f6; border-radius: 60px; color: white; font-size: 16px; }
        .btn { width: 100%; padding: 14px; border-radius: 60px; border: none; font-weight: 700; font-size: 16px; cursor: pointer; margin-bottom: 12px; }
        .btn-primary { background: #3b82f6; color: white; }
        .btn-primary:hover { background: #2563eb; }
        .btn-outline { background: transparent; border: 1px solid #3b82f6; color: #3b82f6; }
        .switch-text { text-align: center; margin-top: 20px; color: #8b9dc3; cursor: pointer; font-size: 14px; }
        .switch-text:hover { color: #3b82f6; }
        .error-msg { color: #ef4444; font-size: 14px; text-align: center; margin-top: 12px; display: none; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .online-badge { background: rgba(59,130,246,0.2); padding: 8px 20px; border-radius: 40px; font-size: 14px; display: inline-block; margin-bottom: 20px; }
        .servers-grid { display: grid; gap: 12px; margin: 20px 0; }
        .server-card { background: rgba(255,255,255,0.05); border-radius: 20px; padding: 16px; display: flex; justify-content: space-between; align-items: center; }
        .server-name { font-weight: 700; }
        .server-ip { font-family: monospace; font-size: 12px; color: #3b82f6; margin-top: 4px; }
        .play-btn { background: #22c55e; border: none; padding: 8px 24px; border-radius: 40px; font-weight: 700; color: white; cursor: pointer; }
        .news-card { background: rgba(255,255,255,0.05); border-radius: 20px; padding: 16px; margin-top: 20px; }
        .news-item { padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.1); font-size: 14px; }
        .logout-btn { background: transparent; border: 1px solid #ef4444; color: #ef4444; padding: 6px 16px; border-radius: 40px; cursor: pointer; }
        .user-info { display: flex; align-items: center; gap: 16px; }
        .avatar { font-size: 32px; }
    </style>
</head>
<body>
<div class="container" id="app">
    <div class="card" id="authCard">
        <div class="logo">GRIF LAUNCHER</div>
        <div class="subtitle">Войдите чтобы продолжить</div>
        <div class="input-group"><input type="text" id="loginNick" placeholder="Никнейм"></div>
        <div class="input-group"><input type="password" id="loginPass" placeholder="Пароль"></div>
        <button class="btn btn-primary" id="doLogin">ВОЙТИ</button>
        <div class="switch-text" id="showRegister">Нет аккаунта? Зарегистрироваться</div>
        <div class="error-msg" id="authError"></div>
    </div>
    <div class="card" id="regCard" style="display:none;">
        <div class="logo">РЕГИСТРАЦИЯ</div>
        <div class="subtitle">Создайте аккаунт</div>
        <div class="input-group"><input type="text" id="regNick" placeholder="Никнейм"></div>
        <div class="input-group"><input type="password" id="regPass" placeholder="Пароль"></div>
        <div class="input-group"><input type="password" id="regCloudPass" placeholder="Облачный пароль"></div>
        <button class="btn btn-primary" id="doRegister">ЗАРЕГИСТРИРОВАТЬСЯ</button>
        <div class="switch-text" id="showLogin">Уже есть аккаунт? Войти</div>
        <div class="error-msg" id="regError"></div>
    </div>
    <div class="card" id="dashboard" style="display:none;">
        <div class="header">
            <div class="logo" style="font-size:24px;">GRIF LAUNCHER</div>
            <div class="user-info"><span class="avatar">🔥</span><span id="userNick"></span><button class="logout-btn" id="logoutBtn">Выйти</button></div>
        </div>
        <div class="online-badge">🔥 24 игрока онлайн</div>
        <div class="servers-grid">
            <div class="server-card"><div><div class="server-name">⭐ GrifMC Pro</div><div class="server-ip">grifmcpro.aternos.me:18014</div></div><button class="play-btn" onclick="playGame('grifmcpro.aternos.me:18014')">Играть</button></div>
            <div class="server-card"><div><div class="server-name">⚡ Vanilla World</div><div class="server-ip">vanilla.grifmc.ru:25565</div></div><button class="play-btn" onclick="playGame('vanilla.grifmc.ru:25565')">Играть</button></div>
            <div class="server-card"><div><div class="server-name">🔫 PvP Arena</div><div class="server-ip">pvp.grfmc.ru:25565</div></div><button class="play-btn" onclick="playGame('pvp.grfmc.ru:25565')">Играть</button></div>
        </div>
        <div class="news-card">
            <h3>📢 НОВОСТИ И АКЦИИ</h3>
            <div class="news-item">🎁 Новый донат-ранг "Легенда" - /fly, /god</div>
            <div class="news-item">🛡️ Защита от гриферов - WorldGuard</div>
            <div class="news-item">📅 Ивент в субботу в 20:00 МСК</div>
        </div>
    </div>
</div>
<script>
    let users = JSON.parse(localStorage.getItem('griflauncher_users') || '{}');
    let currentUser = localStorage.getItem('griflauncher_current_user');
    function saveUsers() { localStorage.setItem('griflauncher_users', JSON.stringify(users)); }
    function showAuth() { document.getElementById('authCard').style.display = 'block'; document.getElementById('regCard').style.display = 'none'; document.getElementById('dashboard').style.display = 'none'; }
    function showReg() { document.getElementById('authCard').style.display = 'none'; document.getElementById('regCard').style.display = 'block'; document.getElementById('dashboard').style.display = 'none'; }
    function showDashboard() { document.getElementById('authCard').style.display = 'none'; document.getElementById('regCard').style.display = 'none'; document.getElementById('dashboard').style.display = 'block'; document.getElementById('userNick').innerText = currentUser; }
    document.getElementById('showRegister')?.addEventListener('click', showReg);
    document.getElementById('showLogin')?.addEventListener('click', showAuth);
    document.getElementById('doLogin')?.addEventListener('click', function() {
        let nick = document.getElementById('loginNick').value.trim();
        let pass = document.getElementById('loginPass').value;
        if (!nick || !pass) { document.getElementById('authError').innerText = 'Заполните все поля'; document.getElementById('authError').style.display = 'block'; return; }
        if (users[nick] && users[nick].password === pass) { currentUser = nick; localStorage.setItem('griflauncher_current_user', currentUser); showDashboard(); }
        else { document.getElementById('authError').innerText = 'Неверный логин или пароль'; document.getElementById('authError').style.display = 'block'; }
    });
    document.getElementById('doRegister')?.addEventListener('click', function() {
        let nick = document.getElementById('regNick').value.trim();
        let pass = document.getElementById('regPass').value;
        let cloudPass = document.getElementById('regCloudPass').value;
        if (!nick || !pass || !cloudPass) { document.getElementById('regError').innerText = 'Заполните все поля'; document.getElementById('regError').style.display = 'block'; return; }
        if (users[nick]) { document.getElementById('regError').innerText = 'Никнейм уже занят'; document.getElementById('regError').style.display = 'block'; return; }
        users[nick] = { password: pass, cloudPassword: cloudPass }; saveUsers(); currentUser = nick; localStorage.setItem('griflauncher_current_user', currentUser); showDashboard();
    });
    document.getElementById('logoutBtn')?.addEventListener('click', function() { currentUser = null; localStorage.removeItem('griflauncher_current_user'); showAuth(); });
    function playGame(ip) { window.location.href = 'minecraft://?server=' + ip; }
    if (currentUser && users[currentUser]) showDashboard(); else showAuth();
</script>
</body>
</html>
